<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal "take a note" widget, modeled on Keep's home-screen widget: it
  doesn't try to mirror live note data (that would need a native bridge to
  Firestore, which is a much bigger project) — tapping it just jumps
  straight into a blank note in the app, which is the highest-value part
  of a notes-app widget anyway: skipping the extra tap of opening the app
  first.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_quick_note_background"
    android:padding="12dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="@string/widget_new_note_label"
        android:textColor="#1F1B13"
        android:textSize="14sp" />

    <TextView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="+"
        android:textColor="#1F1B13"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

</LinearLayout>

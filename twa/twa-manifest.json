{
  "packageId": "com.elitenotebook.twa",
  "host": "elite-notebook.vercel.app",
  "name": "The Elite Notebook",
  "launcherName": "Elite Notebook",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#FDD663",
  "themeColorDark": "#FDD663",
  "navigationColor": "#E9EAF6",
  "navigationColorDark": "#E9EAF6",
  "navigationDividerColor": "#E9EAF6",
  "navigationDividerColorDark": "#E9EAF6",
  "backgroundColor": "#E9EAF6",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://elite-notebook.vercel.app/icon-512.png",
  "maskableIconUrl": "https://elite-notebook.vercel.app/icon-maskable-512.png",
  "appVersion": "2",
  "appVersionCode": 2,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "elitenotebook"
  },
  "webManifestUrl": "https://elite-notebook.vercel.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "minSdkVersion": 24,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "generatorApp": "bubblewrap-cli",
  "splashScreenFadeOutDuration": 300,
  "enableSiteSettingsShortcut": true,
  "shareTarget": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".ppt",
            ".pptx",
            ".txt",
            ".csv",
            "text/*"
          ]
        }
      ]
    }
  }
}

# Copy this file to .env and fill in your Firebase project values.
# Never commit the real .env file — add it to .gitignore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For the Drive panel. Find this in Firebase Console → Authentication →
# Sign-in method → Google → Web SDK configuration → "Web client ID".
# It's the same project, just a different value than VITE_FIREBASE_APP_ID.
VITE_GOOGLE_CLIENT_ID=

# Optional defaults for picture hosting (can also be set in the app under
# Settings > Picture hosting). Unsigned upload preset, no secret key needed.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
